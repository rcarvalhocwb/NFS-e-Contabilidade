node_modules/
# Cobre .env, .env.local, .env.supabase-AAAAMMDD e qualquer copia de
# seguranca: todos levam MASTER_KEY e GATEWAY_API_KEY.
.env
.env.*
!.env.example
*.pfx
.claude/

# Backups: levam tokens de integração, hash de senha dos usuários e o
# certificado A1 cifrado. Nunca no repositório, mesmo sendo ele privado.
backups/
*.backup.json

# Postgres local: binários (300 MB) e os dados do banco.
instalador/postgres/
postgres/

# Artefatos do instalador: pacote montado (222 MB) e o .exe compilado.
instalador/pacote/
instalador/saida/
*.nfsepkg
logs/

# Notas técnicas e esquemas da Sefin: material deles, versionado por eles.
# Baixe de gov.br/nfse > documentacao-tecnica > RTC quando precisar validar.
.notas-tecnicas/
versao.iss
atualizacoes/

# artefatos de análise gerados durante o desenvolvimento
.artefatos/

# Fila e conversas do repassador quando ele roda nesta máquina. Levam telefone
# de cliente e pedido em andamento — entram no backup, nunca no repositório.
dados-relay/
relay/dados/

# O cloudflared, baixado uma vez pelo escritório. Binário de 70 MB de terceiro:
# não é código deste projeto e não se versiona junto.
ferramentas/

# scripts descartáveis de edição
.patch.py
.p.py
.p2.py
.fix.py
.e2e-*.js

# Token da sessao do monitor: sorteado a cada abertura, vale para ligar e
# desligar a emissao do escritorio.
monitor/sessao.txt
.p.js
.p2.js

# O módulo do WhatsApp por sessão própria.
#
# wa/sessao/ SÃO as credenciais do WhatsApp do escritório: quem tiver esses
# arquivos manda mensagem como ele. Trate como o certificado A1.
# wa/token.txt é o token de abertura da janela, sorteado a cada subida.
# wa/node_modules são 113 MB baixados sob demanda, não versionados.
wa/sessao/
wa/token.txt
wa/node_modules/

# Cache do Node portatil baixado pelo preparar-pacote.sh
instalador/.baixados/
