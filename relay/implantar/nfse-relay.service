# Servico do repassador.
#
#   sudo cp nfse-relay.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nfse-relay
#
# Depois:  journalctl -u nfse-relay -f

[Unit]
Description=Repassador WhatsApp -> gateway NFS-e
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nfse
WorkingDirectory=/opt/nfse-relay
EnvironmentFile=/opt/nfse-relay/.env
ExecStart=/usr/bin/node servidor.js

# Reiniciar sempre: se o processo morrer as tres da manha, ninguem esta
# olhando, e a Meta reenvia por 7 dias -- vale a pena estar de pe quando ela
# tentar de novo.
Restart=always
RestartSec=5

# O processo nao precisa de nada fora da propria pasta. Se for invadido, o
# estrago fica contido: sem certificado, sem numeracao, sem XML.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nfse-relay/dados

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
